# Backend configuration
BACKEND_URL=http://localhost:3000

# App configuration
APP_URL=https://app.smarteat.fr/login

# Supabase lead storage
# Use the public project URL and anon key. Do not put the service_role key in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key

# Legacy email configuration (only needed if you keep Netlify functions)
EMAIL_USERNAME=your_gmail@gmail.com
EMAIL_PASSWORD=your_app_password

# Analytics configuration
# Get your Google Analytics ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=

# HotJar configuration (optional)
# Get your HotJar ID from https://insights.hotjar.com/
# Just the numeric ID
HOTJAR_ID=
