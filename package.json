{
  "name": "nuxt-app",
  "private": true,
  "engines": {
    "node": ">=18 <21"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "set NUXT_BUILD_DIR=.nuxt-dev&& nuxt dev --host 127.0.0.1",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:lead": "node --test functions/*.test.js utils/*.test.js",
    "test:content": "node scripts/validate-content.js",
    "test:motion": "node scripts/validate-motion.js",
    "test:solution": "node scripts/validate-solution-section.js",
    "test": "npm run test:lead && npm run test:content && npm run test:motion && npm run test:solution"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.7.0",
    "@types/node": "^18",
    "nuxt": "^3.5.0"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.13",
    "@heroicons/vue": "^2.0.18",
    "@nuxtjs/dotenv": "^1.4.1",
    "aos": "^2.3.4",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "motion-v": "^2.3.0",
    "netlify-lambda": "^2.0.16",
    "nodemailer": "^6.9.4",
    "taos": "^1.0.3"
  }
}
